<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Essential Network Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Camera Permissions and Feature -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- Onboarding / Matching Location Permissions -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Notification Permission (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Audio Recording Permission -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Storage / Media Permissions -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name=".FlirtTimeApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FlirtTime"
        android:usesCleartextTraffic="true">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- True Application Launcher: SplashActivity evaluates session & routes type-safely -->
        <activity
            android:name=".feature.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.FlirtTime.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Onboarding Intro Flow -->
        <activity
            android:name=".feature.onboarding.Intro1Activity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".feature.onboarding.Intro2Activity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".feature.onboarding.Intro3Activity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Runtime Permission Primer -->
        <activity
            android:name=".feature.onboarding.PermissionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Authentication Flow -->
        <activity
            android:name=".feature.auth.login.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.FlirtTime.Login"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".feature.auth.phone.PhoneInputActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".feature.auth.selectCountry.SelectCountryActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".feature.auth.otp.OtpActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".feature.webview.WebviewActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".feature.auth.email.EmailVerifyActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Profile Onboarding & Verification Flow -->
        <activity
            android:name=".feature.onboarding.ProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".feature.onboarding.ProfileVerificationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".feature.onboarding.PicturePreviewActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".feature.onboarding.GestureVerificationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".feature.onboarding.VerificationProcessActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Main Home Destination -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Notifications Screen -->
        <activity
            android:name=".feature.notification.NotificationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Add Moment Screen -->
        <activity
            android:name=".feature.moments.add.AddMomentActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- User My Moments (See All) Screen -->
        <activity
            android:name=".feature.main.profile.MyMomentsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Reusable Image Crop Activity -->
        <activity
            android:name=".core.image.CropActivity"
            android:exported="false"
            android:theme="@style/Theme.FlirtTime"
            android:windowSoftInputMode="adjustNothing" />

        <!-- Other User Profile Screen -->
        <activity
            android:name=".feature.profile.otherUser.OtherUserProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustNothing" />

        <!-- Settings Screen -->
        <activity
            android:name=".feature.profile.settings.SettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Personal Details Screen -->
        <activity
            android:name=".feature.profile.settings.PersonalDetailsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Notification Settings Screen -->
        <activity
            android:name=".feature.profile.settings.NotificationSettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Blocked and Reported Screen -->
        <activity
            android:name=".feature.profile.settings.BlockedReportedActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Edit Profile Screen -->
        <activity
            android:name=".feature.profile.edit.EditProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>