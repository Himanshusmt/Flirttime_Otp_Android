<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle shadow underneath -->
    <item
        android:left="2dp"
        android:top="3dp"
        android:right="2dp"
        android:bottom="1dp">
        <shape android:shape="oval">
            <solid android:color="#20000000" />
            <size
                android:width="24dp"
                android:height="24dp" />
        </shape>
    </item>
    <!-- Fixed White Circle Knob -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="@color/white" />
            <size
                android:width="24dp"
                android:height="24dp" />
        </shape>
    </item>
</layer-list>
