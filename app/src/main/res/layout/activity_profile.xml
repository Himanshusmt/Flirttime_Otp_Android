<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Header containing Back Arrow and "Introduce Yourself." -->
    <include
        android:id="@+id/iv_header"
        layout="@layout/common_header_"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true" />

    <include
        android:id="@+id/view_success_fail"
        layout="@layout/susscess_transperent_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/iv_header"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

    <!-- Continue CTA Button pinned at the bottom -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/tvContinue"
        style="@style/common_style_button_new"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="@dimen/_15sdp"
        android:text="@string/continue_" />

    <!-- Scrollable Form between Header and Continue CTA -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/tvContinue"
        android:layout_below="@id/iv_header"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <!-- 1. Full Name -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/txtInFname"
                style="@style/EditTextInputLayoutStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:textColorHint="@color/light_gry"
                app:boxCollapsedPaddingTop="@dimen/_8sdp"
                app:boxCornerRadiusBottomEnd="@dimen/_8sdp"
                app:boxCornerRadiusBottomStart="@dimen/_8sdp"
                app:boxCornerRadiusTopEnd="@dimen/_8sdp"
                app:boxCornerRadiusTopStart="@dimen/_8sdp"
                app:boxStrokeColor="@color/box_stroke_selector"
                app:boxStrokeWidth="0.8dp"
                app:expandedHintEnabled="true"
                app:hintEnabled="true"
                app:hintTextAppearance="@style/CustomHintTextAppearance"
                app:hintTextColor="@color/light_gry">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFirstName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ "
                    android:fontFamily="@font/fredokaregular"
                    android:hint="Full Name"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences|textPersonName"
                    android:letterSpacing="0"
                    android:maxLength="50"
                    android:paddingVertical="19dp"
                    android:singleLine="true"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/textErrorFN"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:fontFamily="@font/fredokaregular"
                android:letterSpacing="0"
                android:text="First name is required"
                android:textColor="@color/btn_border"
                android:textSize="11sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- 2. Display Name / Nick Name -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/txtNickName"
                style="@style/EditTextInputLayoutStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:textColorHint="@color/light_gry"
                app:boxCollapsedPaddingTop="@dimen/_8sdp"
                app:boxCornerRadiusBottomEnd="@dimen/_8sdp"
                app:boxCornerRadiusBottomStart="@dimen/_8sdp"
                app:boxCornerRadiusTopEnd="@dimen/_8sdp"
                app:boxCornerRadiusTopStart="@dimen/_8sdp"
                app:boxStrokeColor="@color/box_stroke_selector"
                app:boxStrokeWidth="0.8dp"
                app:expandedHintEnabled="true"
                app:hintEnabled="true"
                app:hintTextAppearance="@style/CustomHintTextAppearance"
                app:hintTextColor="@color/light_gry">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNickName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fredokaregular"
                    android:hint="@string/nick_name"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences|text"
                    android:letterSpacing="0"
                    android:maxLength="50"
                    android:paddingVertical="19dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/light_gry"
                    android:textSize="16sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/textErrorNN"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:fontFamily="@font/fredokaregular"
                android:letterSpacing="0"
                android:text="Display name is required"
                android:textColor="@color/btn_border"
                android:textSize="11sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- 3. Date of Birth -->
            <RelativeLayout
                android:id="@+id/linearDob"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/txtInDob"
                    style="@style/EditTextInputLayoutStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColorHint="@color/light_gry"
                    app:boxBackgroundMode="outline"
                    app:boxCollapsedPaddingTop="@dimen/_8sdp"
                    app:boxCornerRadiusBottomEnd="@dimen/_8sdp"
                    app:boxCornerRadiusBottomStart="@dimen/_8sdp"
                    app:boxCornerRadiusTopEnd="@dimen/_8sdp"
                    app:boxCornerRadiusTopStart="@dimen/_8sdp"
                    app:boxStrokeColor="@color/box_stroke_selector"
                    app:expandedHintEnabled="true"
                    app:hintEnabled="true"
                    app:hintTextAppearance="@style/CustomHintTextAppearance"
                    app:hintTextColor="@color/light_gry">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDob"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:fontFamily="@font/fredokaregular"
                        android:hint="@string/date_of_birth"
                        android:letterSpacing="0"
                        android:paddingVertical="19dp"
                        android:textColor="@color/colorSelected"
                        android:textSize="16sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <ImageView
                    android:id="@+id/img_dob"
                    android:layout_width="@dimen/_15sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/_15sdp"
                    android:contentDescription="Select Date of Birth"
                    android:src="@drawable/img_calendar_2" />

            </RelativeLayout>

            <TextView
                android:id="@+id/textErrorDob"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:fontFamily="@font/fredokaregular"
                android:letterSpacing="0"
                android:text="Date of birth is required"
                android:textColor="@color/btn_border"
                android:textSize="11sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/linearNoteDob"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fredokaregular"
                    android:letterSpacing="0"
                    android:text="@string/note"
                    android:textColor="@color/text_gry"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_3sdp"
                    android:fontFamily="@font/fredokaregular"
                    android:letterSpacing="0"
                    android:text="@string/date_of_birth_once_selected_can_not_be_changed"
                    android:textColor="@color/light_gry"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- 4. Gender -->
            <RelativeLayout
                android:id="@+id/linear_gender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/txtInGender"
                    style="@style/EditTextInputLayoutStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColorHint="@color/light_gry"
                    app:boxCollapsedPaddingTop="@dimen/_8sdp"
                    app:boxCornerRadiusBottomEnd="@dimen/_8sdp"
                    app:boxCornerRadiusBottomStart="@dimen/_8sdp"
                    app:boxCornerRadiusTopEnd="@dimen/_8sdp"
                    app:boxCornerRadiusTopStart="@dimen/_8sdp"
                    app:boxStrokeColor="@color/box_stroke_selector"
                    app:boxStrokeWidth="0.8dp"
                    app:expandedHintEnabled="true"
                    app:hintAnimationEnabled="false"
                    app:hintTextAppearance="@style/CustomHintTextAppearance"
                    app:hintTextColor="@color/light_gry">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etGender"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:fontFamily="@font/fredokaregular"
                        android:hint="Gender"
                        android:letterSpacing="0"
                        android:paddingVertical="19dp"
                        android:textColor="@color/colorSelected"
                        android:textSize="16sp" />

                </com.google.android.material.textfield.TextInputLayout>

            </RelativeLayout>

            <TextView
                android:id="@+id/textErrorGender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:fontFamily="@font/fredokaregular"
                android:letterSpacing="0"
                android:text="Gender is required"
                android:textColor="@color/btn_border"
                android:textSize="11sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/linearNoteForGender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fredokaregular"
                    android:letterSpacing="0"
                    android:text="@string/note"
                    android:textColor="@color/text_gry"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_3sdp"
                    android:fontFamily="@font/fredokaregular"
                    android:letterSpacing="0"
                    android:text="@string/gender_once_selected_can_not_be_changed"
                    android:textColor="@color/light_gry"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- 5. About You -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/linearAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textInAbout"
                    style="@style/EditTextInputLayoutStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint=""
                    android:textColorHint="@color/light_gry"
                    app:boxCollapsedPaddingTop="@dimen/_8sdp"
                    app:boxCornerRadiusBottomEnd="@dimen/_8sdp"
                    app:boxCornerRadiusBottomStart="@dimen/_8sdp"
                    app:boxCornerRadiusTopEnd="@dimen/_8sdp"
                    app:boxCornerRadiusTopStart="@dimen/_8sdp"
                    app:boxStrokeColor="@color/box_stroke_selector"
                    app:boxStrokeWidth="0.8dp"
                    app:expandedHintEnabled="true"
                    app:hintAnimationEnabled="true"
                    app:hintEnabled="true"
                    app:hintTextAppearance="@style/CustomHintTextAppearance"
                    app:hintTextColor="@color/light_gry"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAbout"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_80sdp"
                        android:fontFamily="@font/fredokaregular"
                        android:gravity="top|start"
                        android:hint="Looking for your soulmate? Start by writing a bio.."
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine|textCapSentences"
                        android:letterSpacing="0"
                        android:maxLength="150"
                        android:maxLines="4"
                        android:paddingVertical="19dp"
                        android:textColor="@color/colorSelected"
                        android:textColorHint="@color/light_gry"
                        android:textSize="16sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:fontFamily="@font/fredokaregular"
                    android:text="0/150"
                    android:textColor="@color/light_gry"
                    android:textSize="11sp"
                    app:layout_constraintBottom_toBottomOf="@id/textInAbout"
                    app:layout_constraintEnd_toEndOf="@id/textInAbout" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/textErrorAbout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:fontFamily="@font/fredokaregular"
                android:letterSpacing="0"
                android:text="About is required"
                android:textColor="@color/btn_border"
                android:textSize="11sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/linearNoteAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fredokaregular"
                    android:letterSpacing="0"
                    android:text="@string/note"
                    android:textColor="@color/text_gry"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:fontFamily="@font/fredokaregular"
                    android:letterSpacing="0"
                    android:text="@string/tell_us_your_story_craft_a_bio_that_makes_you_stand_out"
                    android:textColor="@color/light_gry"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</RelativeLayout>
