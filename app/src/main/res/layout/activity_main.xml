<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/constrain_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".MainActivity">

    <!-- Fragment Container hosting the Jetpack Navigation Graph -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/relativeBottom"
        android:layout_alignParentTop="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph_main" />

    <!-- Bottom Navigation Bar Matching Modern Unified Look -->
    <RelativeLayout
        android:id="@+id/relativeBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/screen_bg"
        android:clipChildren="false"
        android:clipToPadding="false">

        <RelativeLayout
            android:id="@+id/bottomContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="6dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <!-- Tab 1: Moments -->
                <LinearLayout
                    android:id="@+id/linearMoments"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imgMoment"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/moments"
                        android:src="@drawable/img_moment_select" />

                    <TextView
                        android:id="@+id/txtMoment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/fredokamedium"
                        android:text="@string/moments"
                        android:textColor="@color/brand_red"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Tab 2: Explore -->
                <LinearLayout
                    android:id="@+id/linearExplore"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imgExplore"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/explore"
                        android:src="@drawable/img_explore_unselect" />

                    <TextView
                        android:id="@+id/txtExplore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/fredokamedium"
                        android:text="@string/explore"
                        android:textColor="@color/brand_red"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Mid Spacer for floating center button -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1.22" />

                <!-- Tab 3: Messages -->
                <LinearLayout
                    android:id="@+id/linearMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imgMessage"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/messages"
                        android:src="@drawable/img_message_unselect" />

                    <TextView
                        android:id="@+id/txtMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/fredokamedium"
                        android:text="@string/messages"
                        android:textColor="@color/brand_red"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Tab 4: Profile -->
                <LinearLayout
                    android:id="@+id/linearProfile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imgProfile"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/profile"
                        android:src="@drawable/img_profile_unselect_" />

                    <TextView
                        android:id="@+id/txtProfile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/fredokamedium"
                        android:text="@string/profile"
                        android:textColor="@color/brand_red"
                        android:textSize="10sp" />
                </LinearLayout>

            </LinearLayout>

        </RelativeLayout>

    </RelativeLayout>

    <!-- Floating Center Matches Button:
         Enlarged to 70dp with ~34% (24dp) protruding above navbar top line and ~66% anchored inside navbar. -->
    <FrameLayout
        android:id="@+id/card"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_alignTop="@id/relativeBottom"
        android:layout_centerHorizontal="true"
        android:translationY="-24dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_floating_button_unselected"
        android:elevation="8dp"
        android:outlineProvider="background"
        android:outlineAmbientShadowColor="@color/shadow_soft_black"
        android:outlineSpotShadowColor="@color/shadow_soft_black">

        <ImageView
            android:id="@+id/imgMidNormal"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:clickable="false"
            android:focusable="false"
            android:contentDescription="@null"
            android:src="@drawable/img_bottom"
            app:tint="@color/brand_red" />

    </FrameLayout>

</RelativeLayout>