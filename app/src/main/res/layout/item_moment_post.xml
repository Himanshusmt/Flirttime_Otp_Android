<?xml version="1.0" encoding="utf-8"?>
<!-- Mirrors iOS MomentsTableViewCell: 40dp avatar, name + verified + more, location/time, caption,
     400dp photo card with an action column, or an action row when the moment has no photo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <!-- Left: user avatar -->
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/ivAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:actualImageScaleType="centerCrop"
            app:roundAsCircle="true" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Name, verified badge, more -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvUsername"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/fredokamedium"
                    android:maxLines="1"
                    android:textColor="#252525"
                    android:textSize="16sp"
                    tools:text="heheh" />

                <ImageView
                    android:id="@+id/ivVerified"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="Verified"
                    android:src="@drawable/ic_moment_verified" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/btnMoreOptions"
                    android:layout_width="28dp"
                    android:layout_height="24dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="More options"
                    android:focusable="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_moment_more"
                    app:tint="#252525" />
            </LinearLayout>

            <!-- Location · time -->
            <TextView
                android:id="@+id/tvLocationTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/fredokaregular"
                android:maxLines="1"
                android:textColor="#9E9E9E"
                android:textSize="13sp"
                tools:text="Mumbai · 44m" />

            <!-- Caption (tap toggles "more" / "less" past 250 characters) -->
            <TextView
                android:id="@+id/tvCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/fredokaregular"
                android:textColor="#252525"
                android:textSize="15sp"
                tools:text="Forest walks reset everything" />

            <!-- Photo card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMediaContainer"
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#F2F3F5"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <FrameLayout
                    android:id="@+id/frameMedia"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/vpPostMedia"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <!-- Top-right "1/5" pill -->
                    <LinearLayout
                        android:id="@+id/layoutMediaCountBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_moment_media_counter_ios"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/tvMediaCountBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/fredokamedium"
                            android:includeFontPadding="false"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            tools:text="1/5" />
                    </LinearLayout>

                    <!-- Bottom-left pager: white pill for the current photo, dots for the rest -->
                    <LinearLayout
                        android:id="@+id/layoutMediaDotsIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="14dp"
                        android:layout_marginBottom="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <!-- Action column over the photo -->
                    <LinearLayout
                        android:id="@+id/layoutActions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="10dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <!-- Like (tap = like, long press = who liked) -->
                        <LinearLayout
                            android:id="@+id/btnLike"
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <FrameLayout
                                android:id="@+id/flLikeCircle"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_moment_action_over_photo">

                                <ImageView
                                    android:id="@+id/ivLikeIcon"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="Like"
                                    android:src="@drawable/ic_moment_heart"
                                    app:tint="@color/white" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/tvLikeCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/fredokamedium"
                                android:includeFontPadding="false"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                tools:text="1" />
                        </LinearLayout>

                        <!-- Comment -->
                        <LinearLayout
                            android:id="@+id/btnComment"
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <FrameLayout
                                android:id="@+id/flCommentCircle"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_moment_action_over_photo">

                                <ImageView
                                    android:id="@+id/ivCommentIcon"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="Comment"
                                    android:src="@drawable/ic_moment_comment"
                                    app:tint="@color/white" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/tvCommentCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/fredokamedium"
                                android:includeFontPadding="false"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                tools:text="0" />
                        </LinearLayout>

                        <!-- Gift -->
                        <LinearLayout
                            android:id="@+id/btnGift"
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <FrameLayout
                                android:id="@+id/flGiftCircle"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_moment_action_over_photo">

                                <ImageView
                                    android:id="@+id/ivGiftIcon"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="Gift"
                                    android:src="@drawable/ic_moment_gift"
                                    app:tint="@color/white" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/tvGiftCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/fredokamedium"
                                android:includeFontPadding="false"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                tools:text="0" />
                        </LinearLayout>
                    </LinearLayout>

                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Text-only moments: the actions move here (plain grey style) -->
            <LinearLayout
                android:id="@+id/layoutRowActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="start"
                android:orientation="horizontal"
                android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/postDivider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#E3E5E5" />

</LinearLayout>
