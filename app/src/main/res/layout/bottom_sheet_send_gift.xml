<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootSendGift"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_white_rounded"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="20dp">

    <!-- Top Drag Handle Pill -->
    <View
        android:id="@+id/handleBar"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <!-- Title: Send a gift to {Name} -->
    <TextView
        android:id="@+id/tvGiftTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/fredokasemibold"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        tools:text="" />

    <!-- Coin Balance Row -->
    <LinearLayout
        android:id="@+id/layoutBalance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="Coins Icon"
            android:src="@drawable/ic_coin_profile" />

        <TextView
            android:id="@+id/tvBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:fontFamily="@font/fredokamedium"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="" />
    </LinearLayout>

    <!-- 4-Column Gift Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvGifts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="24dp"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never" />

    <!-- Bottom Action Button (Select a gift / Send Gift) -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSendGift"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginHorizontal="4dp"
        android:background="@drawable/bg_btn_pill_disabled_gray"
        android:enabled="false"
        android:fontFamily="@font/fredokamedium"
        android:text="Select a gift"
        android:textAllCaps="false"
        android:textColor="#A0A0A0"
        android:textSize="15sp" />

</LinearLayout>
