<?xml version="1.0" encoding="utf-8"?>
<!-- iOS PremiumBenefitCard: 48dp blush icon bubble, bold title, 2-line detail. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="2dp"
    android:paddingTop="4dp"
    android:paddingEnd="2dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_premium_card"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:id="@+id/ivBenefitIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_premium_icon_bubble"
            android:importantForAccessibility="no"
            android:padding="14dp"
            android:scaleType="fitCenter"
            app:tint="#D92B2B" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBenefitTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/fredokabold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#252525"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tvBenefitDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="@font/fredokaregular"
                android:maxLines="2"
                android:textColor="#646464"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
