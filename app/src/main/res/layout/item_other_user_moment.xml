<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="135dp"
    android:layout_margin="3dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:cardPreventCornerOverlap="false"
    app:strokeWidth="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Moment Image -->
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/ivMomentThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:actualImageScaleType="centerCrop"
            app:placeholderImage="@drawable/img_login" />

        <!-- Bottom gradient scrim -->
        <View
            android:id="@+id/viewScrim"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_card_gradient_scrim" />

        <!-- Likes & Comments counters -->
        <LinearLayout
            android:id="@+id/layoutCounters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Like Count -->
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_thread_heart_filled"
                app:tint="#FF3B30" />

            <TextView
                android:id="@+id/tvMomentLikes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:fontFamily="@font/fredokasemibold"
                android:textColor="@color/white"
                android:textSize="11sp"
                tools:text="0" />

            <!-- Comment Count -->
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_chat_bubble_white" />

            <TextView
                android:id="@+id/tvMomentComments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:fontFamily="@font/fredokasemibold"
                android:textColor="@color/white"
                android:textSize="11sp"
                tools:text="0" />

        </LinearLayout>

        <!-- "+X See all" dark overlay for 9th item when more exist -->
        <LinearLayout
            android:id="@+id/layoutSeeAllOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#A6000000"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvSeeAllCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fredokasemibold"
                android:textColor="@color/white"
                android:textSize="20sp"
                tools:text="+1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/fredokamedium"
                android:text="See all"
                android:textColor="@color/white"
                android:textSize="13sp" />

        </LinearLayout>

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
