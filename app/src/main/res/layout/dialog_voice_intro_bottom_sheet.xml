<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="560dp"
    android:background="@drawable/bg_bottom_sheet_white_rounded"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="48dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <!-- Top Row with Close Button -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/bg_circle_close_button"
            android:contentDescription="Close"
            android:padding="8dp"
            android:src="@drawable/ic_close_dark" />

    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/fredokabold"
        android:text="Your voice intro"
        android:textColor="#1A1A1A"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/fredokaregular"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:text="Say hi in up to 30 seconds. Matches can play it on your profile."
        android:textColor="#757575"
        android:textSize="13.5sp" />

    <!-- Idea Box Container -->
    <LinearLayout
        android:id="@+id/layoutIdeaBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_voice_idea_box"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingVertical="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fredokabold"
            android:letterSpacing="0.04"
            android:text="NEED AN IDEA?"
            android:textColor="#E53935"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvIdeaPrompt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/fredokasemibold"
                android:text="The quickest way to win me over is..."
                android:textColor="#1A1A1A"
                android:textSize="15.5sp" />

            <ImageView
                android:id="@+id/btnShuffleIdea"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Shuffle prompt idea"
                android:focusable="true"
                android:padding="4dp"
                android:src="@drawable/ic_shuffle_red" />

        </LinearLayout>

    </LinearLayout>

    <!-- Waveform Amplitude Bars -->
    <com.flirttime.feature.main.profile.widget.AudioWaveformView
        android:id="@+id/audioWaveformView"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="16dp" />

    <!-- Timer (e.g. 0:00 / 0:30 during record, 0:04 during review) -->
    <TextView
        android:id="@+id/tvTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/fredokabold"
        android:text="0:00 / 0:30"
        android:textColor="#1A1A1A"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- State 1: Record Mode (Big Mic Button) -->
    <FrameLayout
        android:id="@+id/flRecordContainer"
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:layout_marginTop="16dp">

        <View
            android:id="@+id/viewPulseRing"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_mic_pulse_ring" />

        <FrameLayout
            android:id="@+id/btnRecordMic"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_mic_circle_red"
            android:clickable="true"
            android:elevation="4dp"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivMicIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:contentDescription="Record Microphone"
                android:src="@drawable/ic_mic_white" />

        </FrameLayout>

    </FrameLayout>

    <!-- State 2: Review Mode (3-Button Layout: Re-record, Play/Pause, Save) -->
    <LinearLayout
        android:id="@+id/layoutReviewRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- Left: Re-record Pill Button -->
        <LinearLayout
            android:id="@+id/btnReRecord"
            android:layout_width="84dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_btn_re_record"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Re-record"
                android:src="@drawable/ic_re_record_arrow" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/fredokasemibold"
                android:text="Re-record"
                android:textColor="#E53935"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Center: Big Play/Pause Button with Pulse Ring -->
        <FrameLayout
            android:id="@+id/flPreviewPlayContainer"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginHorizontal="16dp">

            <View
                android:id="@+id/viewPreviewPulseRing"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_mic_pulse_ring" />

            <FrameLayout
                android:id="@+id/btnPreviewPlay"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_mic_circle_red"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivPreviewPlayIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="Play/Pause"
                    android:src="@drawable/ic_play_white" />

            </FrameLayout>

        </FrameLayout>

        <!-- Right: Save Pill Button -->
        <FrameLayout
            android:id="@+id/flSaveContainer"
            android:layout_width="84dp"
            android:layout_height="56dp">

            <LinearLayout
                android:id="@+id/btnSaveVoice"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_btn_save_voice"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Save"
                    android:src="@drawable/ic_crop_check" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/fredokasemibold"
                    android:text="Save"
                    android:textColor="@color/white"
                    android:textSize="12.5sp" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/pbSave"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="@color/white"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

    <!-- Subtext below buttons -->
    <TextView
        android:id="@+id/tvRecordStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/fredokaregular"
        android:gravity="center"
        android:text="Tap the mic to start. At least 3 seconds."
        android:textColor="#757575"
        android:textSize="13.5sp" />

    <!-- Extra generous empty white space below as requested -->
    <View
        android:layout_width="match_parent"
        android:layout_height="80dp" />

</LinearLayout>
