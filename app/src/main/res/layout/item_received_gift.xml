<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="5dp"
    android:background="@drawable/bg_received_gift_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Sender Avatar -->
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/ivSenderAvatar"
        android:layout_width="42dp"
        android:layout_height="42dp"
        app:actualImageScaleType="centerCrop"
        app:placeholderImage="@drawable/img_login"
        app:roundAsCircle="true" />

    <!-- Sender Info & Gift Description -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSenderName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fredokabold"
                android:textColor="#1A1A1A"
                android:textSize="14.5sp"
                tools:text="" />

            <TextView
                android:id="@+id/tvTimeAgo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/fredokaregular"
                android:textColor="#9E9E9E"
                android:textSize="12sp"
                tools:text="" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvGiftDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/fredokaregular"
            android:textColor="#666666"
            android:textSize="12.5sp"
            tools:text="" />

    </LinearLayout>

    <!-- Gift Icon / Emoji -->
    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp">

        <TextView
            android:id="@+id/tvGiftEmoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textSize="22sp"
            tools:text="" />

        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/ivGiftImage"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:visibility="gone"
            app:actualImageScaleType="fitCenter" />

    </FrameLayout>

</LinearLayout>
