<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingVertical="10dp">

    <!-- Spot Category Icon Container (Squircle) -->
    <FrameLayout
        android:id="@+id/layoutSpotIconContainer"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_squircle_pink">

        <ImageView
            android:id="@+id/ivSpotIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="Spot Category Icon"
            android:src="@drawable/ic_spot_cutlery_red" />

    </FrameLayout>

    <!-- Spot Info Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSpotName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/fredokamedium"
            android:maxLines="1"
            android:textColor="#1A1A1A"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Chotu Chinese Center" />

        <TextView
            android:id="@+id/tvSpotAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/fredokaregular"
            android:maxLines="1"
            android:textColor="#8E8E93"
            android:textSize="12sp"
            tools:text="Badi Bhamori, Indore" />

    </LinearLayout>

    <!-- Distance Indicator -->
    <TextView
        android:id="@+id/tvSpotDistance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/fredokamedium"
        android:textColor="#555555"
        android:textSize="12.5sp"
        tools:text="50 ft" />

</LinearLayout>
