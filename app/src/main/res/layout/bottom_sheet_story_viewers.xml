<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_sheet_drag_handle" />

    <!-- Title Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvViewersSheetTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:fontFamily="@font/fredokasemibold"
            android:text="Story Views"
            android:textColor="#1A1A1A"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvTotalViewsBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:fontFamily="@font/fredokamedium"
            android:textColor="#8E8E93"
            android:textSize="13sp"
            tools:text="42 views" />

    </RelativeLayout>

    <!-- Reactions Breakdown Horizontal Row -->
    <HorizontalScrollView
        android:id="@+id/scrollReactionsBreakdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="16dp"
        android:paddingBottom="10dp"
        android:scrollbars="none"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/layoutReactionsBreakdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.8dp"
        android:background="#EFEFEF" />

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/pbViewersLoading"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp"
        android:indeterminateTint="@color/brand_primary"
        android:visibility="visible" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tvEmptyViewers"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="36dp"
        android:layout_marginBottom="36dp"
        android:fontFamily="@font/fredokamedium"
        android:text="No views yet"
        android:textColor="#8E8E93"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Viewers List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvStoryViewers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:maxHeight="380dp"
        android:overScrollMode="never"
        tools:itemCount="3"
        tools:listitem="@layout/item_story_viewer" />

</LinearLayout>
