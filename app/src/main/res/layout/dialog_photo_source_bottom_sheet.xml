<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_white_rounded"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="28dp">

    <!-- 1. Take Photo Button -->
    <LinearLayout
        android:id="@+id/btnTakePhoto"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_btn_pill_red"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Take Photo"
            android:src="@drawable/ic_camera_white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/fredokasemibold"
            android:includeFontPadding="false"
            android:text="Take Photo"
            android:textColor="@color/white"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- 2. Choose from Library Button -->
    <LinearLayout
        android:id="@+id/btnChooseLibrary"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_btn_pill_outline_red"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Choose form Library"
            android:src="@drawable/ic_plus_red" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/fredokasemibold"
            android:includeFontPadding="false"
            android:text="Choose form Library"
            android:textColor="@color/brand_red"
            android:textSize="16sp" />

    </LinearLayout>

</LinearLayout>
