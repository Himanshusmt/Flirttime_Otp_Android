<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardProfile"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="H,1:1.38"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeWidth="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- 1. Profile Photo (Fresco SimpleDraweeView) -->
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/ivProfilePhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:actualImageScaleType="centerCrop" />

            <!-- 2. iOS Metallic Placeholder Background (Shown if no photo) -->
            <ImageView
                android:id="@+id/ivPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Profile placeholder"
                android:scaleType="centerCrop"
                android:src="@drawable/explore_placeholder"
                android:visibility="gone" />

            <!-- 3. Dark Gradient Scrim at Bottom for text contrast -->
            <View
                android:id="@+id/viewScrim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_explore_card_scrim" />

            <!-- 4. iOS Blur Overlay & Lock (Shown when card/tab is locked) -->
            <LinearLayout
                android:id="@+id/layoutBlurOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#99101014"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_online_pill">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="Locked"
                        android:src="@drawable/ic_lock_white" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvUnlockLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/fredokamedium"
                    android:includeFontPadding="false"
                    android:text="Unlock to see"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- 5. Online Status Pill at Top-Left (like iOS) -->
            <LinearLayout
                android:id="@+id/layoutOnlineBadge"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_online_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- Green Dot -->
                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_tab_counter_badge"
                    android:backgroundTint="#34C759" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="@font/fredokamedium"
                    android:includeFontPadding="false"
                    android:text="Online"
                    android:textColor="@color/white"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- 6. SuperLike / Action Badge at Top-Right (like iOS) -->
            <ImageView
                android:id="@+id/ivSuperLikeBadge"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="Super Like"
                android:src="@drawable/ic_super_like_badge"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- 7. Bottom Profile Details Overlay -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingBottom="12dp">

                <!-- Row 1: Name, Age + Verified Achievement Badge -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvNameAge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/fredokasemibold"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textSize="15.5sp"
                        tools:text="tushar42, 19" />

                    <!-- Verified Checkmark Badge (exact match to iOS) -->
                    <ImageView
                        android:id="@+id/ivRibbonBadge"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="Verified Badge"
                        android:src="@drawable/ic_verified_badge"
                        android:visibility="visible" />

                    <!-- Online Dot Indicator next to name -->
                    <View
                        android:id="@+id/dotOnlineNextToName"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_tab_counter_badge"
                        android:backgroundTint="#34C759"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Row 2: Walk Distance (Optional) -->
                <LinearLayout
                    android:id="@+id/layoutDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2.5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:contentDescription="Distance"
                        android:src="@drawable/ic_walk_distance"
                        app:tint="#D9FFFFFF" />

                    <TextView
                        android:id="@+id/tvDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/fredokamedium"
                        android:includeFontPadding="false"
                        android:textColor="#D9FFFFFF"
                        android:textSize="11.5sp"
                        tools:text="7 km away" />

                </LinearLayout>

                <!-- Row 3: Subtitle / Location / Compliment Note -->
                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/fredokaregular"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:textColor="#D9FFFFFF"
                    android:textSize="11.5sp"
                    tools:text="Nearby" />

            </LinearLayout>

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
