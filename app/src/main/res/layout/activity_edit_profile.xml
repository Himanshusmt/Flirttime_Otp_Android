<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg">

    <!-- 1. Top App Bar Header -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/screen_bg"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/toolbarContainer"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="16dp">

            <FrameLayout
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_notification_back_button"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="Back"
                    android:src="@drawable/ic_chevron_back" />

            </FrameLayout>

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="12dp"
                android:fontFamily="@font/fredokasemibold"
                android:text="Edit profile"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                app:layout_constraintBottom_toBottomOf="@+id/btnBack"
                app:layout_constraintEnd_toStartOf="@+id/btnPreview"
                app:layout_constraintStart_toEndOf="@+id/btnBack"
                app:layout_constraintTop_toTopOf="@+id/btnBack" />

            <!-- Preview Pill Button -->
            <LinearLayout
                android:id="@+id/btnPreview"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_pill_preview_red"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fredokamedium"
                    android:text="Preview"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_eye_white" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <!-- 2. Scrollable Body Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="50dp">

            <!-- Profile Completion Banner -->
            <FrameLayout
                android:id="@+id/cardCompletion"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="22dp"
                android:background="@drawable/bg_completion_gradient"
                android:paddingHorizontal="20dp">

                <TextView
                    android:id="@+id/tvCompletionPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|start"
                    android:fontFamily="@font/fredokasemibold"
                    android:text="90% complete"
                    android:textColor="@color/white"
                    android:textSize="18sp" />

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center_vertical|end"
                    android:contentDescription="@null"
                    android:src="@drawable/achievement_badge" />

            </FrameLayout>

            <!-- Section 1: Photos -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fredokasemibold"
                android:text="Photos"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/fredokaregular"
                android:text="Worth a thousand swipes right!"
                android:textColor="@color/text_tertiary"
                android:textSize="13sp" />

            <!-- Asymmetric 6-Photo Grid -->
            <!-- Top section: Big portrait photo on left (spans 2 rows), 2 slots on right -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:orientation="horizontal">

                <!-- Left Primary Photo Slot (Spans full height of top section) -->
                <FrameLayout
                    android:id="@+id/slotPhotoPrimary"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1.6"
                    android:background="@drawable/bg_dashed_photo_slot">

                    <com.facebook.drawee.view.SimpleDraweeView
                        android:id="@+id/ivPhotoPrimary"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:actualImageScaleType="centerCrop"
                        app:roundedCornerRadius="16dp" />

                    <!-- Floating "Profile" pill at bottom-left -->
                    <TextView
                        android:id="@+id/tvProfileBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_translucent_label_pill"
                        android:fontFamily="@font/fredokamedium"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="Profile"
                        android:textColor="@color/white"
                        android:textSize="11.5sp" />

                </FrameLayout>

                <!-- Right 2 Slots (Top: Photo 1, Bottom: Slot 2) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Slot 1 (Top Right) -->
                    <FrameLayout
                        android:id="@+id/slotPhoto1"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginBottom="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dashed_photo_slot">

                        <com.facebook.drawee.view.SimpleDraweeView
                            android:id="@+id/ivPhoto1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:actualImageScaleType="centerCrop"
                            app:roundedCornerRadius="16dp" />

                        <ImageView
                            android:id="@+id/btnDeletePhoto1"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="top|start"
                            android:layout_margin="6dp"
                            android:contentDescription="Delete Photo"
                            android:src="@drawable/ic_delete_cross_circle"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/ivSlot1Placeholder"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_add_photo_placeholder" />

                    </FrameLayout>

                    <!-- Slot 2 (Bottom Right) -->
                    <FrameLayout
                        android:id="@+id/slotPhoto2"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dashed_photo_slot">

                        <com.facebook.drawee.view.SimpleDraweeView
                            android:id="@+id/ivPhoto2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:actualImageScaleType="centerCrop"
                            app:roundedCornerRadius="16dp" />

                        <ImageView
                            android:id="@+id/btnDeletePhoto2"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="top|start"
                            android:layout_margin="6dp"
                            android:contentDescription="Delete Photo"
                            android:src="@drawable/ic_delete_cross_circle"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/ivSlot2Placeholder"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_add_photo_placeholder" />

                    </FrameLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Bottom Row: 3 Equal Photo Slots (Slot 3, Slot 4, Slot 5) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="115dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <!-- Slot 3 -->
                <FrameLayout
                    android:id="@+id/slotPhoto3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dashed_photo_slot">

                    <com.facebook.drawee.view.SimpleDraweeView
                        android:id="@+id/ivPhoto3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:actualImageScaleType="centerCrop"
                        app:roundedCornerRadius="16dp" />

                    <ImageView
                        android:id="@+id/btnDeletePhoto3"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="top|start"
                        android:layout_margin="6dp"
                        android:contentDescription="Delete Photo"
                        android:src="@drawable/ic_delete_cross_circle"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/ivSlot3Placeholder"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_add_photo_placeholder" />

                </FrameLayout>

                <!-- Slot 4 -->
                <FrameLayout
                    android:id="@+id/slotPhoto4"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dashed_photo_slot">

                    <com.facebook.drawee.view.SimpleDraweeView
                        android:id="@+id/ivPhoto4"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:actualImageScaleType="centerCrop"
                        app:roundedCornerRadius="16dp" />

                    <ImageView
                        android:id="@+id/btnDeletePhoto4"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="top|start"
                        android:layout_margin="6dp"
                        android:contentDescription="Delete Photo"
                        android:src="@drawable/ic_delete_cross_circle"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/ivSlot4Placeholder"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_add_photo_placeholder" />

                </FrameLayout>

                <!-- Slot 5 -->
                <FrameLayout
                    android:id="@+id/slotPhoto5"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dashed_photo_slot">

                    <com.facebook.drawee.view.SimpleDraweeView
                        android:id="@+id/ivPhoto5"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:actualImageScaleType="centerCrop"
                        app:roundedCornerRadius="16dp" />

                    <ImageView
                        android:id="@+id/btnDeletePhoto5"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="top|start"
                        android:layout_margin="6dp"
                        android:contentDescription="Delete Photo"
                        android:src="@drawable/ic_delete_cross_circle"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/ivSlot5Placeholder"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_add_photo_placeholder" />

                </FrameLayout>

            </LinearLayout>

            <!-- Photos Note -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="24dp"
                android:fontFamily="@font/fredokaregular"
                android:text="Note: Hold and drag media to set image on match card and long press to delete"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp" />

            <!-- Section 2: Cover Picture -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:fontFamily="@font/fredokasemibold"
                android:text="Cover Picture"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginBottom="24dp">

                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/ivCoverPicture"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:actualImageScaleType="centerCrop"
                    app:placeholderImageScaleType="centerCrop"
                    app:placeholderImage="@drawable/img_login"
                    app:roundedCornerRadius="16dp" />

                <!-- Edit Cover Pill Button -->
                <LinearLayout
                    android:id="@+id/btnChangeCover"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_cover_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_edit_pencil_white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:fontFamily="@font/fredokamedium"
                        android:text="Cover"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                </LinearLayout>

            </FrameLayout>

            <!-- Section 3: My bio -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:fontFamily="@font/fredokasemibold"
                android:text="My bio"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/bg_surface_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_subtle"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <EditText
                        android:id="@+id/etBio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:fontFamily="@font/fredokamedium"
                        android:gravity="top|start"
                        android:hint="Tell the world about yourself..."
                        android:lineSpacingExtra="3dp"
                        android:maxLength="150"
                        android:maxLines="6"
                        android:minLines="3"
                        android:textColor="@color/brand_primary"
                        android:textColorHint="@color/text_tertiary"
                        android:textSize="14.5sp" />

                    <TextView
                        android:id="@+id/tvBioCounter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/fredokamedium"
                        android:text="150/150"
                        android:textColor="@color/brand_primary"
                        android:textSize="12.5sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Section 4: Voice intro -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fredokasemibold"
                android:text="Voice intro"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/fredokaregular"
                android:text="A short recording plays on your profile so matches can hear you."
                android:textColor="@color/text_tertiary"
                android:textSize="13sp" />

            <!-- Voice Player Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_pill_re_record"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <FrameLayout
                    android:id="@+id/btnPlayVoice"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_btn_pill_red"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/ivPlayPauseIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="Play Voice"
                        android:src="@drawable/direction_arrow" />

                </FrameLayout>

                <!-- Voice Waveform View -->
                <com.flirttime.feature.main.profile.widget.AudioWaveformView
                    android:id="@+id/voiceWaveform"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_marginHorizontal="12dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvVoiceDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fredokamedium"
                    android:text="0:05"
                    android:textColor="#555555"
                    android:textSize="13.5sp" />

            </LinearLayout>

            <!-- Re-record & Delete Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="24dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnReRecordVoice"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_re_record"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_mic_red" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/fredokasemibold"
                        android:text="Re-record"
                        android:textColor="@color/brand_primary"
                        android:textSize="14sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnDeleteVoice"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_delete_voice"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_trash_gray" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/fredokasemibold"
                        android:text="Delete"
                        android:textColor="#555555"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Section 5: My interest -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/fredokasemibold"
                android:text="My interest"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <!-- Interests 4-Column Flow Grid -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvInterests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:nestedScrollingEnabled="false" />

            <!-- Section 6: More about me -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fredokasemibold"
                android:text="More about me"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/fredokaregular"
                android:text="The things people wants to know."
                android:textColor="@color/text_tertiary"
                android:textSize="13sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/bg_surface_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_subtle"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:id="@+id/layoutMoreAboutMeContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
