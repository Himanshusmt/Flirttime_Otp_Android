<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutInboxSegment"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:background="@drawable/bg_inbox_segment_capsule"
    android:elevation="2dp"
    android:orientation="horizontal"
    android:padding="4dp">

    <LinearLayout
        android:id="@+id/btnSegmentChats"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/bg_inbox_segment_selected"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivSegmentChats"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chat_bubble_white"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tvSegmentChats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/fredokamedium"
            android:includeFontPadding="false"
            android:text="Chats"
            android:textColor="@color/white"
            android:textSize="15sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnSegmentCalls"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivSegmentCalls"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_phone_receiver"
            app:tint="#18181B"
            tools:tint="#18181B" />

        <TextView
            android:id="@+id/tvSegmentCalls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/fredokamedium"
            android:includeFontPadding="false"
            android:text="Calls"
            android:textColor="#18181B"
            android:textSize="15sp" />

    </LinearLayout>

</LinearLayout>
