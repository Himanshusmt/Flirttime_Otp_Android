<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:paddingBottom="18dp">

    <View
        android:layout_width="48dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:paddingHorizontal="20dp">

        <TextView
            android:id="@+id/tvInfoTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fredokasemibold"
            android:includeFontPadding="false"
            android:text="Message Info"
            android:textColor="#18181B"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvInfoPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="@font/fredokaregular"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:textColor="@color/text_tertiary"
            android:textSize="13.5sp"
            tools:text="Hey! Are we still on for tonight?" />

        <TextView
            android:id="@+id/tvInfoSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/fredokasemibold"
            android:includeFontPadding="false"
            android:textColor="#18181B"
            android:textSize="13sp"
            tools:text="Read by 1 of 3" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessageInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:maxHeight="380dp"
        android:overScrollMode="never"
        android:paddingBottom="6dp"
        tools:listitem="@layout/item_message_info_row" />

    <TextView
        android:id="@+id/tvInfoEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/fredokaregular"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="Delivery details will appear here once the message is sent."
        android:textColor="@color/text_tertiary"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
