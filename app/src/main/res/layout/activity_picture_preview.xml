<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".feature.profile.presentation.preview.PicturePreviewActivity">

    <include
        android:id="@+id/i_header"
        layout="@layout/common_header_"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/i_header"
        android:layout_above="@id/bottomButtonContainer"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/_20sdp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:layout_marginTop="20dp"
                android:background="@drawable/loginnumber_bg"
                android:orientation="vertical"
                android:paddingVertical="@dimen/_20sdp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_gesture"
                    android:layout_width="@dimen/_130sdp"
                    android:layout_height="@dimen/_140sdp"
                    android:layout_gravity="center_horizontal"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_app_logo"
                    app:shapeAppearanceOverlay="@style/RoundedImage9sdp" />

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="9dp"
                    android:fontFamily="@font/fredokaregular"
                    android:letterSpacing="0"
                    android:lineHeight="30sp"
                    android:textAlignment="center"
                    android:textColor="@color/text_gry"
                    android:textSize="22sp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:layout_marginTop="26dp"
                android:fontFamily="@font/fredokaregular"
                android:letterSpacing="0"
                android:lineHeight="27sp"
                android:text="Profile picture successfully updated:"
                android:textColor="@color/text_gry"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_13sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fredokaregular"
                    android:gravity="center_vertical"
                    android:text=" •"
                    android:textColor="@color/light_gry"
                    android:textSize="@dimen/_15ssp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:fontFamily="@font/fredokaregular"
                    android:gravity="center_vertical"
                    android:letterSpacing="0"
                    android:lineHeight="27sp"
                    android:text="@string/now_you_can_complete_further_steps"
                    android:textColor="@color/light_gry"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_13sdp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fredokaregular"
                    android:text=" •"
                    android:textColor="@color/light_gry"
                    android:textSize="@dimen/_15ssp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_marginBottom="@dimen/_5sdp"
                    android:fontFamily="@font/fredokaregular"
                    android:letterSpacing="0"
                    android:lineHeight="20sp"
                    android:text="@string/easily_update_your_profile_picture_at_any_time_through_your_app_settings"
                    android:textColor="@color/light_gry"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:layout_marginTop="@dimen/_15sdp"
                android:fontFamily="@font/fredokaregular"
                android:letterSpacing="0"
                android:lineHeight="20sp"
                android:text="@string/for_added_security_we_ll_ask_you_to_complete_gesture_verification_in_next_step"
                android:textColor="@color/text_gry"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/fredokaregular"
                android:letterSpacing="0"
                android:lineHeight="20sp"
                android:textColor="@color/light_gry"
                android:textSize="14sp" />
        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomButtonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/tvRetake"
            style="@style/common_style_button_new"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_15sdp"
            android:layout_marginEnd="@dimen/_5sdp"
            android:layout_weight="1"
            android:text="@string/retake" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/tv_continue"
            style="@style/common_style_button_new"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_5sdp"
            android:layout_marginEnd="@dimen/_15sdp"
            android:layout_weight="1"
            android:text="@string/continue_" />

    </LinearLayout>

</RelativeLayout>
