<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="14dp"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="68dp"
        android:layout_height="68dp">

        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/ivQuickMomentThumb"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_gravity="center"
            android:contentDescription="Quick Moment"
            app:actualImageScaleType="centerCrop"
            app:placeholderImage="@drawable/ic_settings_person"
            app:roundAsCircle="true"
            app:roundingBorderColor="#EA3355"
            app:roundingBorderWidth="2.5dp" />

        <!-- Optional Floating View/Reaction Badge -->
        <FrameLayout
            android:id="@+id/layoutBadge"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_gravity="bottom|center_horizontal"
            android:background="@drawable/bg_pill_pink_badge"
            android:paddingHorizontal="6dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvBadgeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/fredokabold"
                android:textColor="@color/white"
                android:textSize="9sp"
                tools:text="🔥 3" />

        </FrameLayout>

    </FrameLayout>

    <TextView
        android:id="@+id/tvQuickMomentLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="@font/fredokamedium"
        android:maxLines="1"
        android:maxWidth="72dp"
        android:textColor="#595959"
        android:textSize="12sp"
        tools:text="2h ago" />

</LinearLayout>
