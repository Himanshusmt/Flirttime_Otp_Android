<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="145dp"
    android:layout_margin="3dp"
    app:cardBackgroundColor="#EFEFEF"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardPreventCornerOverlap="false"
    app:strokeWidth="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Moment Media DraweeView -->
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/ivMomentMedia"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:actualImageScaleType="centerCrop" />

        <!-- Top-Right Multi-Media Indicator Icon -->
        <ImageView
            android:id="@+id/ivMultiMedia"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:contentDescription="Multiple Media"
            android:src="@drawable/ic_multi_media"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Bottom Gradient Scrim -->
        <View
            android:id="@+id/viewBottomScrim"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_moment_scrim_bottom" />

        <!-- Bottom Caption & Engagement Stats Overlay -->
        <LinearLayout
            android:id="@+id/layoutBottomDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingBottom="8dp">

            <!-- Caption (if available) -->
            <TextView
                android:id="@+id/tvCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/fredokamedium"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="Hii"
                tools:visibility="visible" />

            <!-- Stats Row: Like count and Comment count -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Red Heart Icon -->
                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:contentDescription="Likes"
                    android:src="@drawable/ic_thread_heart_filled" />

                <!-- Like Count Text -->
                <TextView
                    android:id="@+id/tvLikeCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:fontFamily="@font/fredokamedium"
                    android:textColor="@color/white"
                    android:textSize="10.5sp"
                    tools:text="0" />

                <!-- Speech Bubble Comment Icon -->
                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_marginStart="7dp"
                    android:contentDescription="Comments"
                    android:src="@drawable/ic_thread_comment" />

                <!-- Comment Count Text -->
                <TextView
                    android:id="@+id/tvCommentCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:fontFamily="@font/fredokamedium"
                    android:textColor="@color/white"
                    android:textSize="10.5sp"
                    tools:text="2" />

            </LinearLayout>

        </LinearLayout>

        <!-- Overflow See All Overlay (Shown only for the last +N card when > 9 moments) -->
        <FrameLayout
            android:id="@+id/layoutOverflowSeeAll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#7A000000"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvOverflowCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/fredokabold"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="+3" />

        </FrameLayout>

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
