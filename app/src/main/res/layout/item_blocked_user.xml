<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="10dp">

    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/ivBlockedAvatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:roundAsCircle="true"
        app:placeholderImage="@drawable/img_login"
        app:placeholderImageScaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvBlockedName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fredokasemibold"
            android:text="User Name"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvBlockedUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fredokaregular"
            android:text="\@username"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUnblock"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:fontFamily="@font/fredokamedium"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingHorizontal="14dp"
        android:text="Unblock"
        android:textColor="@color/brand_primary"
        android:textSize="12sp"
        app:cornerRadius="18dp"
        app:strokeColor="@color/brand_primary"
        app:strokeWidth="1dp" />

</LinearLayout>
