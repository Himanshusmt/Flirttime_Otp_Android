<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp">

    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/ivViewerAvatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:actualImageScaleType="centerCrop"
        app:placeholderImage="@drawable/ic_settings_person"
        app:roundAsCircle="true" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvViewerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/fredokasemibold"
            android:maxLines="1"
            android:textColor="#1A1A1A"
            android:textSize="14.5sp"
            tools:text="Rohit Sharma" />

        <TextView
            android:id="@+id/tvViewerTimeAgo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/fredokaregular"
            android:textColor="#8E8E93"
            android:textSize="12sp"
            tools:text="30m ago" />

    </LinearLayout>

    <!-- Reaction Emoji Badge (if viewer reacted) -->
    <TextView
        android:id="@+id/tvViewerReactionEmoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textSize="22sp"
        android:visibility="gone"
        tools:text="&#128293;"
        tools:visibility="visible" />

</LinearLayout>
