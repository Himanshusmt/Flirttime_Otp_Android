<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:orientation="vertical">

    <!-- Top Screen Header Bar -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <!-- Title row: screen title + multi-select entry -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvScreenTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/fredokabold"
                android:includeFontPadding="false"
                android:text="Chats"
                android:textColor="#18181B"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/btnInboxSelect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/fredokasemibold"
                android:includeFontPadding="false"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp"
                android:text="Select"
                android:textColor="@color/brand_primary"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Search Input Pill -->
        <LinearLayout
            android:id="@+id/layoutSearchBar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_search_pill_gray"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Search"
                android:src="@drawable/ic_search_gray" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="@font/fredokaregular"
                android:hint="Search"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="#18181B"
                android:textColorHint="#9CA3AF"
                android:textSize="14.5sp" />

            <ImageView
                android:id="@+id/btnClearSearch"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Clear"
                android:focusable="true"
                android:padding="2dp"
                android:src="@drawable/ic_close_white"
                android:visibility="gone"
                app:tint="#8E8E93" />

        </LinearLayout>

    </LinearLayout>

    <!-- Inbox multi-select toolbar (iOS `MultiSelectActionBar`) -->
    <LinearLayout
        android:id="@+id/layoutInboxSelectionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/btnInboxSelectCancel"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Cancel selection"
            android:focusable="true"
            android:padding="7dp"
            android:src="@drawable/ic_action_cross"
            app:tint="#18181B" />

        <TextView
            android:id="@+id/tvInboxSelectionCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/fredokasemibold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#18181B"
            android:textSize="14sp"
            tools:text="3 selected" />

        <TextView
            android:id="@+id/btnInboxSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/fredokasemibold"
            android:includeFontPadding="false"
            android:paddingHorizontal="6dp"
            android:paddingVertical="6dp"
            android:text="All"
            android:textColor="@color/brand_primary"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/btnInboxMarkRead"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Mark as read"
            android:focusable="true"
            android:padding="7dp"
            android:src="@drawable/ic_action_check_circle"
            app:tint="#18181B" />

        <ImageView
            android:id="@+id/btnInboxArchive"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Archive"
            android:focusable="true"
            android:padding="7dp"
            android:src="@drawable/ic_action_archive"
            app:tint="#18181B" />

        <ImageView
            android:id="@+id/btnInboxMute"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Mute"
            android:focusable="true"
            android:padding="7dp"
            android:src="@drawable/ic_chat_muted"
            app:tint="#18181B" />

        <ImageView
            android:id="@+id/btnInboxPin"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Pin"
            android:focusable="true"
            android:padding="7dp"
            android:src="@drawable/ic_action_pin"
            app:tint="#18181B" />

        <ImageView
            android:id="@+id/btnInboxDelete"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Delete"
            android:focusable="true"
            android:padding="7dp"
            android:src="@drawable/ic_action_delete"
            app:tint="@color/brand_primary" />

    </LinearLayout>

    <!-- Connection / reconnect state (hidden while the socket is up) -->
    <LinearLayout
        android:id="@+id/layoutConnectionBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_connection_banner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvConnectionText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/fredokaregular"
            android:includeFontPadding="false"
            android:text="You're offline — showing saved chats"
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/btnConnectionRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/fredokasemibold"
            android:includeFontPadding="false"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="Retry"
            android:textColor="@color/brand_primary"
            android:textSize="12.5sp" />

    </LinearLayout>

    <!-- Scrollable Conversations Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollChats"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="100dp">

            <!-- 0. Archived Chats Section (collapsible, hidden when empty) -->
            <LinearLayout
                android:id="@+id/layoutArchivedSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:id="@+id/layoutArchivedHeader"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp">

                    <ImageView
                        android:id="@+id/ivArchivedChevron"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="Expand archived chats"
                        android:rotation="-90"
                        android:src="@drawable/ic_chevron_down" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/fredokasemibold"
                        android:includeFontPadding="false"
                        android:text="Archived"
                        android:textColor="#18181B"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvArchivedCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/fredokaregular"
                        android:includeFontPadding="false"
                        android:textColor="#8E8E93"
                        android:textSize="13.5sp"
                        tools:text="3" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvArchivedChats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- 1. Pinned Chats Section -->
            <LinearLayout
                android:id="@+id/layoutPinnedSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <!-- Pinned Chats Header with Bell Icon -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp"
                    android:paddingBottom="8dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_pinned_bell_gray" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/fredokamedium"
                        android:includeFontPadding="false"
                        android:text="Pinned chats"
                        android:textColor="#8E8E93"
                        android:textSize="13.5sp" />

                </LinearLayout>

                <!-- Pinned Chats List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPinnedChats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

            </LinearLayout>

            <!-- 2. Regular Chats Section -->
            <LinearLayout
                android:id="@+id/layoutChatsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical">

                <!-- "Chats" Section Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fredokasemibold"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="20dp"
                    android:paddingBottom="8dp"
                    android:text="Chats"
                    android:textColor="#18181B"
                    android:textSize="18sp" />

                <!-- Regular Chats List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRegularChats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

            </LinearLayout>

            <!-- 3. Empty Search State -->
            <LinearLayout
                android:id="@+id/layoutEmptySearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="60dp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="32dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fredokasemibold"
                    android:text="No chats found"
                    android:textColor="#18181B"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvEmptyMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/fredokaregular"
                    android:gravity="center"
                    android:text="Check your spelling or search for another name"
                    android:textColor="#8E8E93"
                    android:textSize="13.5sp" />

            </LinearLayout>

                <!-- Pagination footer: visible only while the next inbox page is loading -->
                <ProgressBar
                    android:id="@+id/progressLoadMore"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp"
                    android:indeterminateTint="@color/brand_primary"
                    android:visibility="gone" />

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/brand_primary"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
