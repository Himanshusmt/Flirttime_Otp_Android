<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:orientation="vertical">

    <!-- Matches-style header: logo + coins + bell -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/ivAppLogo"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:adjustViewBounds="true"
            android:contentDescription="FlirtTime Logo"
            android:src="@drawable/img_app_title" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/btnCoins"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_coin_pill"
            android:elevation="3.5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="Coins Icon"
                android:src="@drawable/ic_coin_profile" />

            <TextView
                android:id="@+id/tvCoinCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_marginEnd="9dp"
                android:fontFamily="@font/fredokamedium"
                android:text="0"
                android:textColor="#1F1F1F"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Add Coins"
                android:src="@drawable/ic_plus_circle_red" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnNotification"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_circle_icon_button"
            android:elevation="3.5dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="Notifications"
                android:src="@drawable/ic_notification" />

        </FrameLayout>

    </LinearLayout>

    <!-- Chats | Calls segmented control -->
    <include
        android:id="@+id/inboxSegment"
        layout="@layout/view_chat_inbox_segment"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp" />

    <!-- Search + Select row -->
    <LinearLayout
        android:id="@+id/layoutSearchRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/layoutSearchBar"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_pill_gray"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Search"
                android:src="@drawable/ic_search_gray" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="@font/fredokaregular"
                android:hint="Search"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="#18181B"
                android:textColorHint="#9CA3AF"
                android:textSize="14.5sp" />

            <ImageView
                android:id="@+id/btnClearSearch"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Clear"
                android:focusable="true"
                android:padding="2dp"
                android:src="@drawable/ic_close_white"
                android:visibility="gone"
                app:tint="#8E8E93" />

        </LinearLayout>

        <TextView
            android:id="@+id/btnInboxSelect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/fredokasemibold"
            android:includeFontPadding="false"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:text="Select"
            android:textColor="@color/brand_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnDeleteAllCalls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/fredokasemibold"
            android:includeFontPadding="false"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:text="Delete All"
            android:textColor="@color/brand_primary"
            android:textSize="14sp"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

    <!-- Inbox multi-select toolbar (iOS MultiSelectActionBar) -->
    <LinearLayout
        android:id="@+id/layoutInboxSelectionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/btnInboxSelectCancel"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Cancel selection"
            android:focusable="true"
            android:padding="7dp"
            android:src="@drawable/ic_action_cross"
            app:tint="#18181B" />

        <TextView
            android:id="@+id/tvInboxSelectionCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/fredokasemibold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#18181B"
            android:textSize="14sp"
            tools:text="3 selected" />

        <TextView
            android:id="@+id/btnInboxSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/fredokasemibold"
            android:includeFontPadding="false"
            android:paddingHorizontal="6dp"
            android:paddingVertical="6dp"
            android:text="All"
            android:textColor="@color/brand_primary"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/btnInboxMarkRead"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Mark as read"
            android:focusable="true"
            android:padding="7dp"
            android:src="@drawable/ic_action_check_circle"
            app:tint="#18181B" />

        <ImageView
            android:id="@+id/btnInboxArchive"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Archive"
            android:focusable="true"
            android:padding="7dp"
            android:src="@drawable/ic_action_archive"
            app:tint="#18181B" />

        <ImageView
            android:id="@+id/btnInboxMute"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Mute"
            android:focusable="true"
            android:padding="7dp"
            android:src="@drawable/ic_chat_muted"
            app:tint="#18181B" />

        <ImageView
            android:id="@+id/btnInboxPin"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Pin"
            android:focusable="true"
            android:padding="7dp"
            android:src="@drawable/ic_action_pin"
            app:tint="#18181B" />

        <ImageView
            android:id="@+id/btnInboxDelete"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Delete"
            android:focusable="true"
            android:padding="7dp"
            android:src="@drawable/ic_action_delete"
            app:tint="@color/brand_primary" />

    </LinearLayout>

    <!-- Connection / reconnect state -->
    <LinearLayout
        android:id="@+id/layoutConnectionBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_connection_banner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvConnectionText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/fredokaregular"
            android:includeFontPadding="false"
            android:text="You're offline — showing saved chats"
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/btnConnectionRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/fredokasemibold"
            android:includeFontPadding="false"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="Retry"
            android:textColor="@color/brand_primary"
            android:textSize="12.5sp" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Chats section -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollChats"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:overScrollMode="never">

                <LinearLayout
                    android:id="@+id/layoutChatsContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="100dp">

                    <!-- Quick Moments horizontal strip -->
                    <LinearLayout
                        android:id="@+id/layoutQuickMoments"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="4dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/fredokamedium"
                            android:includeFontPadding="false"
                            android:paddingHorizontal="20dp"
                            android:paddingBottom="8dp"
                            android:text="Quick Moments"
                            android:textColor="#18181B"
                            android:textSize="15sp" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvQuickMoments"
                            android:layout_width="match_parent"
                            android:layout_height="148dp"
                            android:clipToPadding="false"
                            android:overScrollMode="never"
                            android:paddingHorizontal="12dp" />

                    </LinearLayout>

                    <!-- Archived -->
                    <LinearLayout
                        android:id="@+id/layoutArchivedSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <LinearLayout
                            android:id="@+id/layoutArchivedHeader"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="20dp">

                            <ImageView
                                android:id="@+id/ivArchivedChevron"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="Expand archived chats"
                                android:rotation="-90"
                                android:src="@drawable/ic_chevron_down" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/fredokasemibold"
                                android:includeFontPadding="false"
                                android:text="Archived"
                                android:textColor="#18181B"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/tvArchivedCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/fredokaregular"
                                android:includeFontPadding="false"
                                android:textColor="#8E8E93"
                                android:textSize="13.5sp"
                                tools:text="3" />

                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvArchivedChats"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            android:overScrollMode="never"
                            android:visibility="gone" />

                    </LinearLayout>

                    <!-- Pinned -->
                    <LinearLayout
                        android:id="@+id/layoutPinnedSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="20dp"
                            android:paddingBottom="8dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_pinned_bell_gray" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:fontFamily="@font/fredokamedium"
                                android:includeFontPadding="false"
                                android:text="Pinned chats"
                                android:textColor="#8E8E93"
                                android:textSize="13.5sp" />

                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvPinnedChats"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            android:overScrollMode="never" />

                    </LinearLayout>

                    <!-- Regular chats -->
                    <LinearLayout
                        android:id="@+id/layoutChatsSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/fredokasemibold"
                            android:includeFontPadding="false"
                            android:paddingHorizontal="20dp"
                            android:paddingBottom="8dp"
                            android:text="Chats"
                            android:textColor="#18181B"
                            android:textSize="18sp" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvRegularChats"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            android:overScrollMode="never" />

                    </LinearLayout>

                    <!-- Empty search / empty inbox -->
                    <LinearLayout
                        android:id="@+id/layoutEmptySearch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="60dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="32dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvEmptyTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/fredokasemibold"
                            android:text="No chats found"
                            android:textColor="#18181B"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tvEmptyMessage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/fredokaregular"
                            android:gravity="center"
                            android:text="Check your spelling or search for another name"
                            android:textColor="#8E8E93"
                            android:textSize="13.5sp" />

                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressLoadMore"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="8dp"
                        android:indeterminateTint="@color/brand_primary"
                        android:visibility="gone" />

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Calls section -->
        <LinearLayout
            android:id="@+id/layoutCallsContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="gone">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipeRefreshCalls"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvCallHistory"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:paddingBottom="100dp" />

                    <LinearLayout
                        android:id="@+id/layoutEmptyCalls"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="32dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_phone_receiver"
                            app:tint="#C4C4C8" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="@font/fredokamedium"
                            android:text="No calls yet"
                            android:textColor="#8E8E93"
                            android:textSize="16sp" />

                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressCalls"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/brand_primary"
                        android:visibility="gone" />

                </FrameLayout>

            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/brand_primary"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
