<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="9dp">

    <!-- Commenter Avatar -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivCommentAvatar"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginTop="2dp"
        android:scaleType="centerCrop"
        android:src="@drawable/img_gallery_demo_girl"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

    <!-- Comment Details Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Header: Username + Time Ago -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCommentUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fredokamedium"
                android:textColor="#1A1A1A"
                android:textSize="13.5sp"
                android:textStyle="bold"
                tools:text="pawan123" />

            <TextView
                android:id="@+id/tvCommentTimeAgo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:fontFamily="@font/fredokaregular"
                android:textColor="#8E8E93"
                android:textSize="12sp"
                tools:text="31m" />

        </LinearLayout>

        <!-- Comment Text Body -->
        <TextView
            android:id="@+id/tvCommentContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/fredokaregular"
            android:lineSpacingExtra="2dp"
            android:textColor="#262626"
            android:textSize="13.5sp"
            tools:text="Test hpp" />

        <!-- Future Reply Action / Replies Preview (Extensible placeholder) -->
        <TextView
            android:id="@+id/tvReplyAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/fredokamedium"
            android:textColor="#8E8E93"
            android:textSize="11.5sp"
            android:visibility="gone"
            android:text="Reply" />

    </LinearLayout>

</LinearLayout>
