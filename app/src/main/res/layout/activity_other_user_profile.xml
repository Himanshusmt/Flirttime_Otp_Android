<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootOtherUserProfile"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="100dp">

            <!-- 1. Top Cover Photo Container -->
            <FrameLayout
                android:id="@+id/coverContainer"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                app:layout_constraintTop_toTopOf="parent">

                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/ivCoverPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Cover Photo"
                    app:actualImageScaleType="centerCrop"
                    app:placeholderImage="@drawable/img_login" />

                <!-- Bottom gradient fade into solid white -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_cover_gradient_fade" />

                <!-- Top Action Icons (Back & More) -->
                <LinearLayout
                    android:id="@+id/layoutTopActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="48dp">

                    <!-- Back Button -->
                    <FrameLayout
                        android:id="@+id/btnBack"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_translucent_action_circle"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="Back"
                            android:src="@drawable/ic_chevron_back"
                            app:tint="@color/white" />

                    </FrameLayout>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <!-- More Options (Block / Report) -->
                    <FrameLayout
                        android:id="@+id/btnMore"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_translucent_action_circle"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="More Options"
                            android:src="@drawable/ic_more_dots"
                            app:tint="@color/white" />

                    </FrameLayout>

                </LinearLayout>

            </FrameLayout>

            <!-- 2. Circular Avatar with Red Gradient Ring -->
            <FrameLayout
                android:id="@+id/avatarContainer"
                android:layout_width="106dp"
                android:layout_height="106dp"
                android:layout_marginTop="-53dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/coverContainer">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_avatar_ring_red" />

                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/ivAvatar"
                    android:layout_width="98dp"
                    android:layout_height="98dp"
                    android:layout_gravity="center"
                    app:placeholderImage="@drawable/img_login"
                    app:roundAsCircle="true" />

            </FrameLayout>

            <!-- 3. Name, Age & Verified Badge -->
            <LinearLayout
                android:id="@+id/layoutNameAge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/avatarContainer">

                <TextView
                    android:id="@+id/tvNameAge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fredokamedium"
                    android:textColor="#1A1A1A"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="dummy_cindy, 28" />

                <ImageView
                    android:id="@+id/ivVerifiedBadge"
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="Verified"
                    android:src="@drawable/ic_verified_blue" />

            </LinearLayout>

            <!-- 4. Location & Distance -->
            <LinearLayout
                android:id="@+id/layoutLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layoutNameAge">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_location_pin_red" />

                <TextView
                    android:id="@+id/tvLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/fredokaregular"
                    android:textColor="#777777"
                    android:textSize="13sp"
                    tools:text="Indore, Madhya Pradesh · 1.0 km away" />

            </LinearLayout>

            <!-- 5. Bio Quote -->
            <TextView
                android:id="@+id/tvBio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/fredokaregular"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2"
                android:paddingHorizontal="32dp"
                android:textColor="#333333"
                android:textSize="13.5sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layoutLocation"
                tools:text="“Sunday mood: coffee, playlist on shuffle and zero plans ☕🎶 Let us explore hidden cafes!”" />

            <!-- 6. Photos Section Header -->
            <LinearLayout
                android:id="@+id/layoutPhotosHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                app:layout_constraintTop_toBottomOf="@id/tvBio">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fredokamedium"
                    android:text="Photos"
                    android:textColor="#1A1A1A"
                    android:textSize="16.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPhotosCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_red_pill_count"
                    android:fontFamily="@font/fredokamedium"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="1.5dp"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="3" />

            </LinearLayout>

            <!-- Photos Carousel -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPhotos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintTop_toBottomOf="@id/layoutPhotosHeader"
                tools:listitem="@layout/item_other_user_photo" />

            <!-- 7. Interests Section Header -->
            <LinearLayout
                android:id="@+id/layoutInterestsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                app:layout_constraintTop_toBottomOf="@id/rvPhotos">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fredokamedium"
                    android:text="Interests"
                    android:textColor="#1A1A1A"
                    android:textSize="16.5sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Common Interests Badge -->
                <TextView
                    android:id="@+id/tvCommonInterestsBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_pink_badge"
                    android:fontFamily="@font/fredokamedium"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="#E02B52"
                    android:textSize="11.5sp"
                    tools:text="💎 2 in common" />

            </LinearLayout>

            <!-- Interests Chips RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvInterests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintTop_toBottomOf="@id/layoutInterestsHeader"
                tools:listitem="@layout/item_other_user_interest" />

            <!-- 8. Moments Section Header -->
            <LinearLayout
                android:id="@+id/layoutMomentsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                app:layout_constraintTop_toBottomOf="@id/rvInterests">

                <TextView
                    android:id="@+id/tvMomentsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fredokamedium"
                    android:textColor="#1A1A1A"
                    android:textSize="16.5sp"
                    android:textStyle="bold"
                    tools:text="Moments · 1" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/btnSeeAllMoments"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/fredokamedium"
                    android:text="See all"
                    android:textColor="#8E8E93"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Moments Carousel -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMoments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintTop_toBottomOf="@id/layoutMomentsHeader"
                tools:listitem="@layout/item_other_user_moment" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/brand_red"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 9. Floating Bottom Action Bar -->
    <LinearLayout
        android:id="@+id/layoutBottomActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Action: Nope / Cross -->
        <FrameLayout
            android:id="@+id/btnNope"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_floating_action_white"
            android:clickable="true"
            android:elevation="6dp"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="Dislike"
                android:src="@drawable/ic_action_cross" />

        </FrameLayout>

        <!-- Action: Like / Heart (Large Center Button) -->
        <FrameLayout
            android:id="@+id/btnLike"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/bg_floating_action_red"
            android:clickable="true"
            android:elevation="8dp"
            android:focusable="true">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:contentDescription="Like"
                android:src="@drawable/ic_heart_action_white" />

        </FrameLayout>

        <!-- Action: Chat / Message -->
        <FrameLayout
            android:id="@+id/btnChat"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_floating_action_white"
            android:clickable="true"
            android:elevation="6dp"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="Chat"
                android:src="@drawable/ic_chat_bubble_red" />

        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
