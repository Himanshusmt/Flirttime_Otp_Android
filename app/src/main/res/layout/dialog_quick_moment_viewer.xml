<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootViewer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Story Media Image (Photos) -->
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/ivViewerMedia"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Story Background"
        android:visibility="gone"
        app:actualImageScaleType="centerCrop" />

    <!-- Text Story Gradient Background Layer -->
    <FrameLayout
        android:id="@+id/layoutViewerTextBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient_story_red">

        <TextView
            android:id="@+id/tvViewerTextContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/fredokamedium"
            android:gravity="center"
            android:paddingHorizontal="28dp"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold"
            tools:text="Hii" />

    </FrameLayout>

    <!-- Top Overlay: Progress Bar & Author Header -->
    <LinearLayout
        android:id="@+id/layoutViewerTopContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="12dp">

        <!-- Progress Bar at very top (5-sec Story Timeline) -->
        <ProgressBar
            android:id="@+id/progressBarStory"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginHorizontal="12dp"
            android:indeterminate="false"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/bg_story_progress_bar" />

        <!-- Header: Avatar + Name + More Menu + Close -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/ivViewerAuthorAvatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:actualImageScaleType="centerCrop"
                    app:placeholderImage="@drawable/ic_settings_person"
                    app:roundAsCircle="true"
                    app:roundingBorderColor="@color/white"
                    app:roundingBorderWidth="1.5dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvViewerAuthorName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/fredokasemibold"
                        android:shadowColor="#80000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        tools:text="Mike Hussey" />

                    <TextView
                        android:id="@+id/tvViewerStoryTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/fredokaregular"
                        android:shadowColor="#80000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="2"
                        android:textColor="#CCFFFFFF"
                        android:textSize="11.5sp"
                        tools:text="2 min ago" />

                </LinearLayout>

            </LinearLayout>

            <!-- Actions Container: Menu (...) + Close (X) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnViewerMenu"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_circle_translucent_action"
                    android:contentDescription="More options"
                    android:padding="7dp"
                    android:src="@drawable/ic_more_dots"
                    app:tint="@color/white" />

                <ImageView
                    android:id="@+id/btnViewerClose"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_circle_translucent_action"
                    android:contentDescription="Close"
                    android:padding="8dp"
                    android:src="@drawable/ic_close"
                    app:tint="@color/white" />

            </LinearLayout>

        </RelativeLayout>

    </LinearLayout>

    <!-- Bottom Actions Overlay -->
    <LinearLayout
        android:id="@+id/layoutViewerBottomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="24dp">

        <!-- ===================================================================== -->
        <!-- CASE A: OWN STORY ACTIONS (Bottom Views Element -> Opens Viewers Sheet)-->
        <!-- ===================================================================== -->
        <LinearLayout
            android:id="@+id/layoutOwnStoryActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="gone">

            <LinearLayout
                android:id="@+id/btnStoryViewers"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_pill_story_viewers"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Views"
                    android:src="@drawable/ic_eye_white" />

                <TextView
                    android:id="@+id/tvStoryViewersCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/fredokasemibold"
                    android:text="0 views"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- ===================================================================== -->
        <!-- CASE B: OTHER USER STORY ACTIONS (Fixed Emojis + Reply Input)          -->
        <!-- ===================================================================== -->
        <LinearLayout
            android:id="@+id/layoutOtherStoryActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Fixed 6 Reaction Emojis Row -->
            <LinearLayout
                android:id="@+id/layoutReactionEmojis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:weightSum="6">

                <TextView
                    android:id="@+id/btnReactLove"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="&#128525;"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/btnReactFire"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="&#128293;"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/btnReactLaugh"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="&#128514;"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/btnReactWow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="&#128558;"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/btnReactClap"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="&#128079;"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/btnReactHeart"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="&#10084;&#65039;"
                    android:textSize="28sp" />

            </LinearLayout>

            <!-- Reply Input Box Pill -->
            <LinearLayout
                android:id="@+id/layoutReplyBox"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_pill_story_reply"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <EditText
                    android:id="@+id/etReplyMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/fredokaregular"
                    android:hint="Reply to story..."
                    android:imeOptions="actionSend"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences|textShortMessage"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textColorHint="#99FFFFFF"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/btnSendReply"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Send reply"
                    android:padding="4dp"
                    android:src="@drawable/ic_paper_plane_red" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
