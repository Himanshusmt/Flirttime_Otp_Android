<?xml version="1.0" encoding="utf-8"?>
<!-- Android port of iOS PremiumViewController: hero, benefits carousel, plan tiles, comparison, coin shop, CTA footer. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootPremium"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_premium_screen" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top bar: back circle · "Premium" · Restore -->
        <FrameLayout
            android:id="@+id/layoutTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="6dp">

            <FrameLayout
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_premium_white_circle"
                android:clickable="true"
                android:contentDescription="Back"
                android:elevation="4dp"
                android:focusable="true">

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_sf_chevron_left"
                    app:tint="#252525" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:accessibilityHeading="true"
                android:fontFamily="@font/fredokabold"
                android:includeFontPadding="false"
                android:text="Premium"
                android:textColor="#000000"
                android:textSize="20sp" />

            <LinearLayout
                android:id="@+id/btnRestore"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/bg_premium_restore"
                android:clickable="true"
                android:contentDescription="Restore purchases"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:id="@+id/ivRestoreIcon"
                    android:layout_width="13dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_sf_arrow_clockwise"
                    app:tint="#D92B2B" />

                <ProgressBar
                    android:id="@+id/progressRestore"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:indeterminateTint="#D92B2B"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/fredokabold"
                    android:includeFontPadding="false"
                    android:text="Restore"
                    android:textColor="#D92B2B"
                    android:textSize="15sp" />
            </LinearLayout>
        </FrameLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollPremium"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="6dp"
                android:paddingBottom="24dp">

                <!-- Hero -->
                <FrameLayout
                    android:id="@+id/heroCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_premium_hero">

                    <FrameLayout
                        android:id="@+id/heroHearts"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingStart="22dp"
                        android:paddingTop="26dp"
                        android:paddingEnd="22dp"
                        android:paddingBottom="24dp">

                        <FrameLayout
                            android:layout_width="92dp"
                            android:layout_height="92dp"
                            android:background="@drawable/bg_premium_logo_ring"
                            android:importantForAccessibility="no">

                            <FrameLayout
                                android:layout_width="72dp"
                                android:layout_height="72dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_premium_logo_core">

                                <ImageView
                                    android:layout_width="34dp"
                                    android:layout_height="34dp"
                                    android:layout_gravity="center"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/ic_premium_ft_logo" />
                            </FrameLayout>

                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_gravity="top|end"
                                android:layout_marginTop="2dp"
                                android:layout_marginEnd="2dp"
                                android:background="@drawable/bg_premium_white_circle"
                                android:elevation="3dp"
                                android:padding="8dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_sf_crown_fill"
                                app:tint="#D92B2B" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="24dp"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/bg_premium_chip_glass"
                            android:fontFamily="@font/fredokabold"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:paddingHorizontal="10dp"
                            android:text="FLIRTTIME PREMIUM"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvHeroTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:accessibilityHeading="true"
                            android:fontFamily="@font/fredokabold"
                            android:gravity="center"
                            android:textColor="#FFFFFF"
                            android:textSize="26sp"
                            tools:text="Find your match faster" />

                        <TextView
                            android:id="@+id/tvHeroSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/fredokaregular"
                            android:gravity="center"
                            android:textColor="#E6FFFFFF"
                            android:textSize="15sp"
                            tools:text="More matches, more conversations, more you." />
                    </LinearLayout>
                </FrameLayout>

                <!-- Already-Premium banner -->
                <LinearLayout
                    android:id="@+id/memberBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_premium_member_banner"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_premium_white_circle"
                        android:importantForAccessibility="no"
                        android:padding="11dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_sf_crown_fill"
                        app:tint="#D92B2B" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/fredokabold"
                            android:includeFontPadding="false"
                            android:text="You're a Premium user"
                            android:textColor="#D92B2B"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/fredokaregular"
                            android:text="Everything is unlocked — enjoy the full Flirttime experience."
                            android:textColor="#646464"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Benefits carousel -->
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/pagerBenefits"
                    android:layout_width="match_parent"
                    android:layout_height="112dp"
                    android:layout_marginTop="18dp"
                    android:clipChildren="false"
                    android:clipToPadding="false" />

                <LinearLayout
                    android:id="@+id/layoutDots"
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:gravity="center"
                    android:orientation="horizontal" />

                <!-- Plans -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:accessibilityHeading="true"
                    android:fontFamily="@font/fredokabold"
                    android:includeFontPadding="false"
                    android:text="Choose your plan"
                    android:textColor="#000000"
                    android:textSize="18sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPlans"
                    android:layout_width="match_parent"
                    android:layout_height="184dp"
                    android:layout_marginTop="8dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:overScrollMode="never" />

                <TextView
                    android:id="@+id/tvBonusChip"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_premium_bonus_chip"
                    android:fontFamily="@font/fredokamedium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="16dp"
                    android:textColor="#6D1616"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="🎁 Includes 100 bonus coins"
                    tools:visibility="visible" />

                <ProgressBar
                    android:id="@+id/progressPlans"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="18dp"
                    android:indeterminateTint="#D92B2B" />

                <TextView
                    android:id="@+id/tvPlansError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="@font/fredokaregular"
                    android:gravity="center"
                    android:textColor="#646464"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnRetryPlans"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="18dp"
                    android:background="?attr/selectableItemBackground"
                    android:fontFamily="@font/fredokamedium"
                    android:padding="6dp"
                    android:text="Try Again"
                    android:textColor="#D92B2B"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- Free vs Premium -->
                <LinearLayout
                    android:id="@+id/cardComparison"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_premium_card_large"
                    android:elevation="3dp"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="18dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvComparisonTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:accessibilityHeading="true"
                            android:fontFamily="@font/fredokabold"
                            android:textColor="#252525"
                            android:textSize="17sp"
                            tools:text="Included in 1 Month" />

                        <TextView
                            android:layout_width="44dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/fredokamedium"
                            android:gravity="center"
                            android:text="Free"
                            android:textColor="#757575"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="66dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_premium_pill_premium"
                            android:fontFamily="@font/fredokabold"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="Premium"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_premium_divider" />

                    <LinearLayout
                        android:id="@+id/layoutFeatureRows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- Coin shop shortcut -->
                <LinearLayout
                    android:id="@+id/cardShop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_premium_card"
                    android:clickable="true"
                    android:contentDescription="Coin shop. Top up for Super Likes, compliments and calls."
                    android:elevation="3dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/fredokabold"
                            android:includeFontPadding="false"
                            android:text="Just need a few coins?"
                            android:textColor="#252525"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/fredokaregular"
                            android:text="Top up for Super Likes, compliments and calls."
                            android:textColor="#646464"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="88dp"
                        android:layout_height="31dp"
                        android:layout_marginStart="12dp"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_premium_coin_shop" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Footer: CTA + renewal copy + legal links -->
        <LinearLayout
            android:id="@+id/layoutFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:elevation="8dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="20dp"
            android:paddingBottom="2dp">

            <FrameLayout
                android:id="@+id/btnContinue"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_premium_cta"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true">

                <LinearLayout
                    android:id="@+id/layoutContinueContent"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="15dp"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_sf_crown_fill"
                        app:tint="#FFFFFF" />

                    <TextView
                        android:id="@+id/tvContinueTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/fredokabold"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="Get Premium"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressContinue"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="#FFFFFF"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvRenewal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/fredokaregular"
                android:gravity="center"
                android:textColor="#757575"
                android:textSize="11sp"
                tools:text="₹499 every month. Renews automatically until cancelled. Cancel anytime in Google Play at least 24 hours before renewal." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnPrivacy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:fontFamily="@font/fredokamedium"
                    android:padding="6dp"
                    android:text="Privacy Policy"
                    android:textColor="#757575"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnTerms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:background="?attr/selectableItemBackground"
                    android:fontFamily="@font/fredokamedium"
                    android:padding="6dp"
                    android:text="Terms of Use"
                    android:textColor="#757575"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
