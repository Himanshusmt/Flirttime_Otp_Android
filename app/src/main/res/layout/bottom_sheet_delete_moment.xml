<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_comments"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/fredokabold"
        android:text="Delete Moment?"
        android:textColor="#1A1A1A"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Subtitle / Warning message -->
    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/fredokaregular"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="Are you sure you want to delete this moment?\nThis action cannot be undone."
        android:textColor="#757575"
        android:textSize="13.5sp" />

    <!-- Delete Moment Action Button (App Red Pill CTA) -->
    <LinearLayout
        android:id="@+id/btnDeleteMoment"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_btn_pill_red"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivDeleteIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_trash_white" />

        <TextView
            android:id="@+id/tvDeleteText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/fredokasemibold"
            android:includeFontPadding="false"
            android:text="Delete moment"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <ProgressBar
            android:id="@+id/progressDelete"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:indeterminateTint="@color/white"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Cancel Button (App Soft Pill CTA) -->
    <LinearLayout
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_btn_pill_cancel"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fredokasemibold"
            android:includeFontPadding="false"
            android:text="Cancel"
            android:textColor="#1A1A1A"
            android:textSize="16sp" />

    </LinearLayout>

</LinearLayout>
