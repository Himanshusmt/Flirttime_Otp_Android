<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:paddingBottom="14dp">

    <View
        android:layout_width="48dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_sheet_handle" />

    <!-- Quoted snippet of the tapped message -->
    <TextView
        android:id="@+id/tvMessagePreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_composer_banner"
        android:ellipsize="end"
        android:fontFamily="@font/fredokaregular"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:paddingHorizontal="14dp"
        android:paddingVertical="11dp"
        android:textColor="#18181B"
        android:textSize="15sp"
        tools:text="Hey! Are we still on for tonight?" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/fredokasemibold"
        android:includeFontPadding="false"
        android:text="React"
        android:textColor="#18181B"
        android:textSize="16sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutReactions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="14dp"
        android:background="@color/border_subtle" />

    <!-- Reply -->
    <LinearLayout
        android:id="@+id/rowReply"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Reply"
            android:src="@drawable/ic_action_reply"
            app:tint="#18181B" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/fredokaregular"
            android:includeFontPadding="false"
            android:text="Reply"
            android:textColor="#18181B"
            android:textSize="17sp" />

    </LinearLayout>

    <!-- Forward -->
    <LinearLayout
        android:id="@+id/rowForward"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Forward"
            android:src="@drawable/ic_action_forward"
            app:tint="#18181B" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/fredokaregular"
            android:includeFontPadding="false"
            android:text="Forward"
            android:textColor="#18181B"
            android:textSize="17sp" />

    </LinearLayout>

    <!-- Copy the message text -->
    <LinearLayout
        android:id="@+id/rowCopy"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Copy"
            android:src="@drawable/ic_action_copy"
            app:tint="#18181B" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/fredokaregular"
            android:includeFontPadding="false"
            android:text="Copy"
            android:textColor="#18181B"
            android:textSize="17sp" />

    </LinearLayout>

    <!-- Edit (outgoing text only) -->
    <LinearLayout
        android:id="@+id/rowEdit"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Edit"
            android:src="@drawable/ic_action_edit"
            app:tint="#18181B" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/fredokaregular"
            android:includeFontPadding="false"
            android:text="Edit"
            android:textColor="#18181B"
            android:textSize="17sp" />

    </LinearLayout>

    <!-- Pin / Unpin -->
    <LinearLayout
        android:id="@+id/rowPin"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageView
            android:id="@+id/ivPinIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Pin"
            android:src="@drawable/ic_action_pin"
            app:tint="#18181B" />

        <TextView
            android:id="@+id/tvPinLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/fredokaregular"
            android:includeFontPadding="false"
            android:text="Pin"
            android:textColor="#18181B"
            android:textSize="17sp" />

    </LinearLayout>

    <!-- Select (bulk actions) -->
    <LinearLayout
        android:id="@+id/rowSelect"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Select"
            android:src="@drawable/ic_action_select"
            app:tint="#18181B" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/fredokaregular"
            android:includeFontPadding="false"
            android:text="Select"
            android:textColor="#18181B"
            android:textSize="17sp" />

    </LinearLayout>

    <!-- Message info: delivered / read by -->
    <LinearLayout
        android:id="@+id/rowMessageInfo"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Message info"
            android:src="@drawable/ic_action_info"
            app:tint="#18181B" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/fredokaregular"
            android:includeFontPadding="false"
            android:text="Message Info"
            android:textColor="#18181B"
            android:textSize="17sp" />

    </LinearLayout>

    <!-- Retry (failed sends only) -->
    <LinearLayout
        android:id="@+id/rowRetry"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Retry"
            android:src="@drawable/ic_refresh_sync"
            app:tint="#18181B" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/fredokaregular"
            android:includeFontPadding="false"
            android:text="Retry"
            android:textColor="#18181B"
            android:textSize="17sp" />

    </LinearLayout>

    <!-- Delete for me -->
    <LinearLayout
        android:id="@+id/rowDeleteMe"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Delete for me"
            android:src="@drawable/ic_action_delete"
            app:tint="#FF3B30" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/fredokaregular"
            android:includeFontPadding="false"
            android:text="Delete for Me"
            android:textColor="#FF3B30"
            android:textSize="17sp" />

    </LinearLayout>

    <!-- Delete for everyone -->
    <LinearLayout
        android:id="@+id/rowDeleteEveryone"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Delete for everyone"
            android:src="@drawable/ic_action_delete"
            app:tint="#FF3B30" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/fredokaregular"
            android:includeFontPadding="false"
            android:text="Delete for Everyone"
            android:textColor="#FF3B30"
            android:textSize="17sp" />

    </LinearLayout>

</LinearLayout>
