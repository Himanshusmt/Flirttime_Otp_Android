<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded_white"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="32dp"
    android:paddingBottom="28dp">

    <!-- Title / Main Question -->
    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/fredokasemibold"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="Are you sure you want to logout?"
        android:textColor="@color/text_primary"
        android:textSize="18sp" />

    <!-- Optional Subtitle Message -->
    <TextView
        android:id="@+id/tvDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/fredokaregular"
        android:gravity="center"
        android:text="Subtitle message"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Left Button (Outline) -->
        <TextView
            android:id="@+id/btnPositive"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_dialog_outline_red"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/fredokasemibold"
            android:gravity="center"
            android:text="Yes"
            android:textColor="#EA3355"
            android:textSize="16sp" />

        <View
            android:layout_width="16dp"
            android:layout_height="0dp" />

        <!-- Right Button (Filled) -->
        <TextView
            android:id="@+id/btnNegative"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_dialog_filled_red"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/fredokasemibold"
            android:gravity="center"
            android:text="No"
            android:textColor="@color/white"
            android:textSize="16sp" />

    </LinearLayout>

</LinearLayout>
