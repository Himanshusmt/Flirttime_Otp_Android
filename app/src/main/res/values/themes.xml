<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.FlirtTime" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- FlirtTime Core Color Scheme -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/text_on_brand</item>
        <item name="colorSurface">@color/bg_surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:windowBackground">@color/bg_app_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
    </style>

    <!-- ========================================================================= -->
    <!-- FLIRTTIME DESIGN SYSTEM TYPOGRAPHY (FREDOKA FONT FAMILY)                  -->
    <!-- ========================================================================= -->

    <!-- Display & Large Headings -->
    <style name="TextAppearance.FlirtTime.Display" parent="TextAppearance.Material3.DisplayMedium">
        <item name="fontFamily">@font/fredokabold</item>
        <item name="android:fontFamily">@font/fredokabold</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.FlirtTime.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/fredokasemibold</item>
        <item name="android:fontFamily">@font/fredokasemibold</item>
        <item name="android:textSize">21sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.FlirtTime.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/fredokamedium</item>
        <item name="android:fontFamily">@font/fredokamedium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.FlirtTime.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@font/fredokamedium</item>
        <item name="android:fontFamily">@font/fredokamedium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Body & Paragraphs -->
    <style name="TextAppearance.FlirtTime.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/fredokaregular</item>
        <item name="android:fontFamily">@font/fredokaregular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="TextAppearance.FlirtTime.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/fredokaregular</item>
        <item name="android:fontFamily">@font/fredokaregular</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.FlirtTime.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/fredokaregular</item>
        <item name="android:fontFamily">@font/fredokaregular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <!-- Labels, Pills & Buttons -->
    <style name="TextAppearance.FlirtTime.LabelPill" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/fredokamedium</item>
        <item name="android:fontFamily">@font/fredokamedium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.FlirtTime.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/fredokamedium</item>
        <item name="android:fontFamily">@font/fredokamedium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_on_brand</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="common_style_button_new">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@drawable/button_selector</item>
        <item name="backgroundTint">@null</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="android:paddingTop">@dimen/_11sdp</item>
        <item name="android:paddingBottom">@dimen/_11sdp</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/fredokamedium</item>
        <item name="android:layout_marginStart">@dimen/_15sdp</item>
        <item name="android:layout_marginEnd">@dimen/_15sdp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="common_style_button" parent="common_style_button_new" />

    <style name="EditInput_chat">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="EditTextInputLayoutStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:textCursorDrawable">@null</item>
        <item name="colorPrimary">@color/red</item>
        <item name="cursorColor">@color/red</item>
        <item name="android:colorControlActivated">@color/btn_border</item>
        <item name="android:colorControlNormal">@color/border_light_gry</item>
        <item name="android:colorAccent">@color/btn_border</item>
        <item name="boxStrokeColor">@color/box_stroke_selector</item>
        <item name="boxStrokeWidth">0.8dp</item>
    </style>

    <style name="UserInfoLinear">
        <item name="android:background">@color/transparent</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/_15sdp</item>
        <item name="android:layout_marginLeft">16dp</item>
        <item name="android:layout_marginRight">16dp</item>
    </style>

    <style name="CustomHintTextAppearance" parent="TextAppearance.AppCompat">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/light_gry</item>
    </style>

    <style name="RoundedImage9sdp">
        <item name="cornerSize">@dimen/_9sdp</item>
    </style>

    <style name="Widget.FlirtTime.FilterChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">50dp</item>
        <item name="chipMinHeight">38dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
        <item name="chipBackgroundColor">@color/selector_filter_chip_bg</item>
        <item name="chipStrokeColor">@color/selector_filter_chip_stroke</item>
        <item name="chipStrokeWidth">1.2dp</item>
        <item name="android:textColor">@color/selector_filter_chip_text</item>
        <item name="android:fontFamily">@font/fredokamedium</item>
        <item name="fontFamily">@font/fredokamedium</item>
        <item name="android:textSize">14sp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconVisible">false</item>
        <item name="chipStartPadding">12dp</item>
        <item name="chipEndPadding">12dp</item>
    </style>

    <style name="Widget.FlirtTime.ProfileInterestChip" parent="Widget.Material3.Chip.Assist">
        <item name="chipCornerRadius">50dp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
        <item name="chipBackgroundColor">#F4F5F7</item>
        <item name="chipStrokeColor">@android:color/transparent</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textColor">#262626</item>
        <item name="android:fontFamily">@font/fredokamedium</item>
        <item name="fontFamily">@font/fredokamedium</item>
        <item name="android:textSize">13.5sp</item>
        <item name="chipStartPadding">12dp</item>
        <item name="chipEndPadding">12dp</item>
        <item name="rippleColor">#20000000</item>
    </style>

    <!-- Edge-to-Edge Bottom Sheet Theme (Removes system nav bar gray scrim) -->
    <style name="FlirtTimeBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/FlirtTimeBottomSheetModal</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
        <item name="enableEdgeToEdge">true</item>
    </style>

    <style name="FlirtTimeBottomSheetModal" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="TransparentBottomSheetDialogTheme" parent="FlirtTimeBottomSheetDialogTheme" />

    <!-- Full-Screen Immersive Quick Moments Story Dialog Theme -->
    <style name="FullScreenQuickMomentDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/FlirtTimeBottomSheetModal</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="enableEdgeToEdge">true</item>
    </style>


    <style name="Theme.FlirtTime" parent="Base.Theme.FlirtTime" />

    <!-- Splash Screen Theme: 100% immersive edge-to-edge without any nav/status bar tint -->
    <style name="Theme.FlirtTime.Splash" parent="Theme.FlirtTime">
        <item name="android:windowBackground">@drawable/img_splash_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@color/brand_red</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@drawable/img_splash_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor" tools:targetApi="s">@android:color/transparent</item>
    </style>

    <!-- Login Screen Theme: 100% immersive edge-to-edge with matching red background & transparent system bars -->
    <style name="Theme.FlirtTime.Login" parent="Theme.FlirtTime">
        <item name="android:windowBackground">#CE0707</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
    </style>
</resources>